# The admin gets the same strict content security policy as the members app (2026-09-18).
# Scripts only from this site and the two libraries it imports; connections only to this
# site, the Supabase project, the GEX worker and the two public market-data APIs the
# Memecoins tab reads. Run TARGET=admin tests/security-csp-probe.mjs before adding a host.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https://cqdignbleethroyxxvzr.supabase.co; connect-src 'self' https://cqdignbleethroyxxvzr.supabase.co wss://cqdignbleethroyxxvzr.supabase.co https://gex-worker.frankiepc3.workers.dev https://api.coingecko.com https://api.llama.fi https://esm.sh; frame-src 'self'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
