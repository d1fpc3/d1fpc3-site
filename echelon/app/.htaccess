# The members app gets a strict content security policy (2026-09-18). Scripts may only come
# from this site and the three libraries it imports; the page may only talk to this site,
# its Supabase project, the two D1 workers and Stripe. Anything injected cannot load code
# from, or send data to, anywhere else. Run tests/security-csp-probe.mjs before adding a host.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://cdn.jsdelivr.net https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https://cqdignbleethroyxxvzr.supabase.co; connect-src 'self' https://cqdignbleethroyxxvzr.supabase.co wss://cqdignbleethroyxxvzr.supabase.co https://gex-worker.d1fpc3.workers.dev https://gex-worker.frankiepc3.workers.dev https://forex-factory-discord.frankiepc3.workers.dev https://esm.sh https://api.stripe.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://www.youtube-nocookie.com https://www.youtube.com https://iframe.mediadelivery.net https://*.cloudflarestream.com; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
