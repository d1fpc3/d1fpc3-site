# HTML always revalidates: without this, browsers heuristic-cache pages off
# Last-Modified and people keep seeing pre-deploy versions of the app.
<IfModule mod_headers.c>
  # Security headers (2026-09-18): no framing by other sites (clickjacking), no MIME
  # sniffing, a short referrer, HTTPS only, and only the device features the app uses
  # (biometric unlock needs publickey-credentials).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  # the landing page itself (and only it) gets the strict policy; see pricing/.htaccess for the shape
  SetEnvIf Request_URI "^/(index\.html)?$" ECHELON_LANDING
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://seenrank.com https://js.stripe.com https://*.js.stripe.com https://checkout.stripe.com https://esm.sh https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://cqdignbleethroyxxvzr.supabase.co; connect-src 'self' https://cqdignbleethroyxxvzr.supabase.co wss://cqdignbleethroyxxvzr.supabase.co https://gex-worker.d1fpc3.workers.dev https://gex-worker.frankiepc3.workers.dev https://prop-deals-discord.frankiepc3.workers.dev https://discord.com https://seenrank.com https://uyyzaynifzbsjciiuqhf.supabase.co https://api.stripe.com https://checkout.stripe.com https://esm.sh; frame-src 'self' https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'self'; upgrade-insecure-requests" env=ECHELON_LANDING
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self), publickey-credentials-get=(self), publickey-credentials-create=(self)"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Extensionless URLs (e.g. /me -> me.html)
RewriteEngine On

# The Echelon landing moved to the site root (2026-08-10). Only the bare
# /echelon page redirects; /echelon/app, /echelon/welcome and /echelon/admin
# stay where they are (Stripe returns and Supabase auth redirects point there).
RewriteRule ^echelon/?$ https://d1fpc3.com/ [R=301,L]

# d1 trading retired 2026-08-25; the journal folds into Echelon.
RewriteRule ^trading(/.*)?$ https://d1fpc3.com/ [R=301,L]

# If the requested path doesn't exist as a file or directory,
# and a matching .html file exists, serve it.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
