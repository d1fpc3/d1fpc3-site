# /privacy/: strict content security policy (2026-09-18). Scripts only from this site, the
# analytics pixel, Stripe and the two libraries; connections only to this site, Supabase, the
# GEX worker, Discord's member count, the pixel and Stripe. Dry-run with
# tests/security-csp-public-probe.mjs before adding a host.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://seenrank.com https://js.stripe.com https://*.js.stripe.com https://checkout.stripe.com https://esm.sh https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://cqdignbleethroyxxvzr.supabase.co; connect-src 'self' https://cqdignbleethroyxxvzr.supabase.co wss://cqdignbleethroyxxvzr.supabase.co https://gex-worker.d1fpc3.workers.dev https://gex-worker.frankiepc3.workers.dev https://prop-deals-discord.frankiepc3.workers.dev https://discord.com https://seenrank.com https://uyyzaynifzbsjciiuqhf.supabase.co https://api.stripe.com https://checkout.stripe.com https://esm.sh; frame-src 'self' https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
